# Slack App credentials (from api.slack.com)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Salesforce ECA credentials
SF_CLIENT_ID=your-consumer-key
SF_CLIENT_SECRET=your-consumer-secret
SF_ORG_URL=https://navy-program-management--fullcopy.sandbox.my.salesforce.com
SF_MY_DOMAIN=navy-program-management--fullcopy

# MCP Server URL (My Domain format)
